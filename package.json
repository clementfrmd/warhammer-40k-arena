{
  "name": "warhammer-40k-arena",
  "version": "1.0.0",
  "description": "Warhammer 40K Battle Arena - Turn-based strategy game with AI bot support",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "bot": "node bot/claude-bot.js",
    "bot:debug": "node bot/claude-bot.js --debug",
    "docker:build": "docker build -t wh40k-arena .",
    "docker:run": "docker run -p 3000:3000 wh40k-arena"
  },
  "keywords": [
    "warhammer",
    "40k",
    "game",
    "turn-based",
    "strategy",
    "ai",
    "claude",
    "bot"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.52.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
